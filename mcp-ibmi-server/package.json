{
  "name": "mcp-ibmi-server",
  "version": "1.0.0",
  "description": "MCP server wrapping IBM i SSH calls as structured tools for the IBM i Application Navigator",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true
  }
}
