# IBM i Application Navigator — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# PUB400 IBM i hostname
IBMI_HOST=pub400.com

# Your PUB400 SSH username
IBMI_USER=your_username_here

# Absolute path to your SSH private key file (key-based auth)
# Example (Linux/Mac): /home/yourname/.ssh/id_ed25519
# Example (Windows):   C:\Users\yourname\.ssh\id_ed25519
IBMI_SSH_KEY_PATH=/path/to/your/ssh/private/key

# SSH port (default 22 for PUB400)
IBMI_PORT=22
